---
layout: basic
---
<%= yield %>

<footer class="ui-footer">
  <div>
    <div class="ui-address">
      <img src="/images/logos/grow.png" alt="Substance Lab" class="ui-logo">
      <div>Substance Lab ApS</div>
      <div>Jernbanegade 27</div>
      <div>6000 Kolding</div>
    </div>

    <div>
      <div><a href="mailto:hi@substancelab.com">hi@substancelab.com</a></div>
      <div><a href="tel:+4571990999">+45 7199 0999</a></div>
    </div>
  </div>

  <nav>
    <a class="ui-footer-nav-title" href="<%= projects_url %>"><%= I18n.t("navigation.work") %></a>
    <ul>
      <% featured_case_studies.each do |project| %>
        <li><a href="<%= project_url(project) %>"><%= project["name"] %></a></li>
      <% end %>
    </ul>
  </nav>

  <% if page_exists?(services_url) %>
    <nav>
      <a class="ui-footer-nav-title" href="<%= services_url %>"><%= I18n.t("navigation.services") %></a>
      <ul>
        <li><a href="/services/seed/"><%= I18n.t("navigation.seed") %></a></li>
        <li><a href="/services/development/"><%= I18n.t("navigation.development") %></a></li>
        <li><a href="/services/maintenance/"><%= I18n.t("navigation.maintenance") %></a></li>
      </ul>
    </nav>
  <% end %>

  <nav>
    <a class="ui-footer-nav-title" href="/#company"><%= I18n.t("navigation.about") %></a>
    <ul>
      <li><a href="/#person"><%= I18n.t("navigation.people") %></a></li>
      <% if blog_articles.any? %>
        <li><a href="<%= articles_path %>"><%= I18n.t("navigation.articles") %></a></li>
      <% end %>
      <li><a href="/jobs/"><%= I18n.t("navigation.jobs") %></a></li>
    </ul>
  </nav>

  <div>
    <a href="https://www.linkedin.com/company/substance-lab/">LinkedIn</a>
  </div>
</footer>
