<% slot :hero do %>
  <h1><%= current_article.data.title %></h1>
<% end %>

<div class="ui-article">
  <%= article_intro(current_article) %>
  <%= article_body(current_article) %>
</div>

<nav>
  <div class="previous">
    <% if (prev_article = current_article.previous_resource) %>
      <%= link_to_article(prev_article) %>
    <% end %>
  </div>
  <div class="next">
    <% if (next_article = current_article.next_resource) %>
      <%= link_to_article(next_article) %>
    <% end %>
  </div>
</nav>
