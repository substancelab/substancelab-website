<% author_key = current_article.data.author %>
<% author = person(author_key) %>
<% slot :scripts do %>
  <%= article_structured_data(current_article) %>
<% end %>

<%= render Hero.new(:lede => article_intro(article_html), :title => current_article.data.title) do %>
  <% if author %>
    <a class="ui-attribution" href="<%= person_url(author_key) %>">
      <%# The name is in the link text, so the photo doesn't need to repeat it %>
      <img alt="" class="ui-avatar" src="<%= person_avatar_path(author_key) %>">
      <div>
        <div class="author"><%= author["name"] %></div>
        <div><%= person_title(author) %></div>
      </div>
    </a>
  <% end %>
<% end %>

<article class="ui-content">
  <%= article_body(article_html) %>
</article>

<nav class="ui-page-navigation">
  <div class="ui-previous-page">
    <% if (prev_article = older_article(current_article)) %>
      <%= link_to_article(prev_article, prefix: "←") %>
    <% end %>
  </div>
  <div class="ui-next-page">
    <% if (next_article = newer_article(current_article)) %>
      <%= link_to_article(next_article, suffix: "→") %>
    <% end %>
  </div>
</nav>
