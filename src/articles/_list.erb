<section class="ui-content ui-article-list">
  <% articles.each do |article| %>
    <%# The entire article links to it, so the summary can't contain links %>
    <a class="ui-article-list-item" href="<%= article.relative_url %>">
      <h2><%= article.data.title %></h2>
      <%= strip_links(article_summary(article)) %>
    </a>
  <% end %>
</section>
