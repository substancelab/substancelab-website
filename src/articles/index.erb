---ruby
front_matter do
  layout :layout
  title I18n.translate("articles.index.page_title")
  description I18n.translate("articles.index.meta_description")
end
---

<% slot :hero do %>
  <%= render Hero.new(
    title: "Artikler",
    lede: "Substance Lab bloggen - Skriverier med substans"
  ) %>
<% end %>

<section class="ui-content ui-article-list">
  <% blog_articles.each do |article| %>
    <%# The entire article links to it, so the summary can't contain links %>
    <a class="ui-article-list-item" href="<%= article.relative_url %>">
      <h2><%= article.data.title %></h2>
      <%= strip_links(article_summary(article)) %>
    </a>
  <% end %>
</section>
