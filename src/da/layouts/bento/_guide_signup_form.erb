<% form_id ||= "bento-formkit-hhxpuzj" %>
<form action="https://track.bentonow.com/forms/0ddd81e0025b2163c1c99894da608315/%24subscribe-fra-ide-til-launch?hardened=true" method="POST" enctype="multipart/form-data" class="bento-formkit" id="<%= form_id %>" onkeydown="if(event.keyCode===13){event.preventDefault();this.requestSubmit ? this.requestSubmit() : this.submit();}">
  <input type="hidden" name="redirect" value="https://substancelab.dk/guide/thank-you">
  <div class="form-inputs-container">
    <label>Arbejds e-mail
      <input type="email" name="email" class="bento-formkit-input" required pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$">
    </label>
    <label>Navn
      <input type="text" name="fields_first_name" class="bento-formkit-input" required>
    </label>
    <label>Telefon
      <input type="phone" name="fields_phone_number" class="bento-formkit-input" required>
    </label>
    <button type="submit" class="bento-formkit-button">Ja tak, send mig guide og nyhedsbrev</button>
    <div class="bento-formkit-disclosure">Vi sender dig guiden i en e-mail. Derudover får du en række opfølgende og uddybende mails. Du kan fravælge mails til hver en tid.</div>
  </div>
</form>
<style>
/* Bento's formkit styles its own forms, hence the !importants */
#<%= form_id %> {
  text-align: left !important;
}
:is(h1, h2, h3, h4) + #<%= form_id %> {
  margin-top: 1em !important;
}
#<%= form_id %> .form-inputs-container {
  display: flex !important;
  flex-direction: column !important;
  gap: 1em !important;
}
#<%= form_id %> .bento-formkit-input {
  background: #ffffff !important;
  border: 1px solid rgba(var(--color-text-primary-rgb), 0.3) !important;
  border-radius: 0 !important;
  box-sizing: border-box !important;
  color: #191919 !important;
  display: block !important;
  font: inherit !important;
  font-size: var(--font-size-base) !important;
  margin-top: 0.25em !important;
  padding: 0.6em 0.8em !important;
  width: 100% !important;
}
#<%= form_id %> input:focus {
  border-color: var(--color-brand-primary) !important;
  box-shadow: 0 0 0 3px rgba(var(--color-brand-primary-rgb), 0.3) !important;
  outline: none !important;
}
#<%= form_id %> button {
  background: linear-gradient(to top left, var(--color-brand-primary) 0%, var(--color-brand-secondary) 100%) !important;
  border: none !important;
  border-radius: 0 !important;
  color: #000000 !important;
  cursor: pointer !important;
  font: inherit !important;
  font-weight: bold !important;
  padding: 0.8em 1em !important;
  width: 100% !important;
}
#<%= form_id %> button:hover {
  filter: brightness(0.93) !important;
}
#<%= form_id %> .bento-formkit-disclosure {
  color: inherit !important;
  font-size: var(--font-size-sm) !important;
  line-height: 1.45 !important;
  margin-top: 0 !important;
  opacity: 0.7 !important;
}
</style>

<% unless @bento_form_sniffer_included %>
  <% slot :bottom_of_page do %>
    <script src="https://app.bentonow.com/modules/form-sniffer.js" async defer></script>
  <% end %>
  <% @bento_form_sniffer_included = true %>
<% end %>
