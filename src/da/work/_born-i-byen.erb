      </div>

      <div class="statistics-figure">
        <div class="statistics-number">100%</div>
        <div class="statistics-label">ny frontend, lanceret uden nedetid</div>
      </div>

      <div class="statistics-figure">
        <div class="statistics-number">Få dage</div>
