<% project = resource.data._project %>
<% set_meta_tags(
  :description => localized(project["description"] || {}),
  :title => project_page_title(project)
) %>

<article class="ui-content">
  <%= localized_partial "work/#{project["slug"]}", {:project => project} %>

  <%= project_image(project) %>

  <section class="ui-content tripple">
    <div>
      <h3><%= project["name"] %></h3>
      <p><%= localized(project["description"] || {}) %></p>
      <% if project["website"] %>
        <div class="website">
          <a href="<%= project["website"] %>"><%= project["website"] %></a>
        </div>
      <% end %>
    </div>

    <div>
      <h3><%= I18n.t("work.index.substance_lab_did") %></h3>
      <p><%= project_services(project) %></p>
    </div>

    <div>
      <h3><%= I18n.t("work.index.technologies_used") %></h3>
      <p><%= (project["technologies"] || []).sort.to_sentence %></p>
    </div>
  </section>
</article>

<% other_studies = case_studies.reject { |case_study| case_study["slug"] == project["slug"] } %>
<% if other_studies.any? %>
  <h2><%= I18n.translate("work.show.other_case_studies") %></h2>
  <div class="ui-gallery">
    <% other_studies.sample(3).each do |case_study| %>
      <%= render CaseStudyCard.new(case_study: case_study) %>
    <% end %>
  </div>
<% end %>

<% hero_image(project_hero_image_path(project)) %>
